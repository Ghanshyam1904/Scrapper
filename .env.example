# ---- Provider: freellm | ollama | groq ----
LLM_PROVIDER=freellm

# ---- FreeLLMAPI ----
FREELLM_BASE_URL=http://localhost:3001/v1
FREELLM_API_KEY=
FREELLM_MODEL=nemotron-3-ultra-550b

# ---- Ollama (fallback / local) ----
OLLAMA_MODEL=qwen3:4b

# ---- Groq (Only LLM_PROVIDER=if there) ----
GROQ_API_KEY=

MAX_OUTPUT_TOKENS=7000
LOGIN_WAIT_SECONDS=120

SYSTEM_PROMPT_FILE=system_prompt.txt
CRAWL4AI_NO_CLOUD_NOTICE=1

# Optional default email for login walls
LOGIN_EMAIL=

FORCE_HEADED=1