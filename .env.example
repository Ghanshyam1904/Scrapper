# LLM Provider: 'ollama' (local) or 'groq' (cloud)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3.5:4b

# If using LLM_PROVIDER=groq, enter your API key:
GROQ_API_KEY=gsk_your_actual_groq_api_key

# System prompt file & banner settings:
SYSTEM_PROMPT_FILE=system_prompt.txt
CRAWL4AI_NO_CLOUD_NOTICE=1

# Optional default email for login walls (leave blank if preferred):
LOGIN_EMAIL=
