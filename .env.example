# ========== LLM PROVIDER CONFIGURATION ==========
# Choose ONE provider: ollama (local, free) | groq (cloud) | freellm (local API)
LLM_PROVIDER=ollama

# ---- OLLAMA (Local, Default) ----
# Install Ollama: https://ollama.com  →  ollama pull qwen3:4b
OLLAMA_MODEL=qwen3:4b

# ---- GROQ (Cloud, Recommended for multi-page tasks) ----
# Sign up at https://console.groq.com/keys  →  get your API key
GROQ_API_KEY=gsk_your_actual_groq_api_key_here

# ---- FREELLMAPI (Local alternative) ----
# Run FreeLLMAPI server locally: http://localhost:3001/v1
# FREELLM_BASE_URL=http://localhost:3001/v1
# FREELLM_API_KEY=your_freellm_key
# FREELLM_MODEL=nemotron-3-ultra-550b

# ========== GENERAL SETTINGS ==========
# Maximum output tokens per LLM call (prevents "128000 token" errors)
MAX_OUTPUT_TOKENS=4000

# System prompt file (relative to project root)
SYSTEM_PROMPT_FILE=system_prompt.txt

# ========== OPTIONAL: Login / Auth ==========
# Default email for auto-fill on login walls (press Enter to use this)
LOGIN_EMAIL=your_email@example.com

# ========== BROWSER / STEALTH ==========
# Force headed (visible) browser — set to 0 for headless (recommended)
# Set to 1 only if you need to manually solve CAPTCHAs visually
FORCE_HEADED=0

# Proxy URL (if required): e.g. http://127.0.0.1:8080
PROXY_URL=

# ========== CRAWL4AI SETTINGS ==========
# Disable cloud notice (set to 1 to suppress, 0 to show)
CRAWL4AI_NO_CLOUD_NOTICE=1